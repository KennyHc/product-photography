---
import ProjectView from '../../../views/ProjectView.astro';
import { getPrevNext, getProjects } from '../../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('es');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, ...getPrevNext(projects, entry.id) },
  }));
}

const { entry, prev, next } = Astro.props;
---

<ProjectView lang="es" entry={entry} prev={prev} next={next} />
