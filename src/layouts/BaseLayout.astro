---
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { absoluteUrl, href } from '../lib/paths';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/lightbox.css';

interface Props {
  lang: Lang;
  /** Un-prefixed English-style path, e.g. "/work/sample-ecommerce". */
  path: string;
  title: string;
  description?: string;
  /** Un-prefixed path to the equivalent page in the other language, used for the language switcher and hreflang links. */
  altPath?: string;
  ogImage?: ImageMetadata;
  transparentHeader?: boolean;
}

const {
  lang,
  path,
  title,
  description,
  altPath = path,
  ogImage,
  transparentHeader = false,
} = Astro.props;

const t = useTranslations(lang);
const desc = description ?? t('site.description');
const enPath = lang === 'en' ? path : altPath;
const esPath = lang === 'es' ? path : altPath;
const ogImageUrl = ogImage ? new URL(ogImage.src, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={absoluteUrl(path, lang)} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(enPath, 'en')} />
    <link rel="alternate" hreflang="es" href={absoluteUrl(esPath, 'es')} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(enPath, 'en')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={absoluteUrl(path, lang)} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg', 'en')} />
  </head>
  <body>
    <a href="#main" class="visually-hidden">{t('nav.skip')}</a>
    <Header lang={lang} altPath={altPath} transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
