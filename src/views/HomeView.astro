---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { href } from '../lib/paths';
import { site } from '../lib/site';
import { getProjects } from '../lib/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import hero from '../assets/home/hero.jpg';
import heroPortrait from '../assets/home/hero-portrait.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const srcset = async (src: ImageMetadata, widths: number[]) =>
  (
    await Promise.all(
      widths.map(async (width) => {
        const img = await getImage({ src, width, format: 'webp' });
        return `${img.src} ${width}w`;
      }),
    )
  ).join(', ');

const landscapeSet = await srcset(hero, [1280, 1920, 2400]);
const portraitSet = await srcset(heroPortrait, [800, 1200, 1600]);
const heroDefault = await getImage({ src: hero, width: 1920, format: 'webp' });

const projects = (await getProjects(lang)).slice(0, 4);

const shots = [
  { n: '01', label: t('shot.white') },
  { n: '02', label: t('shot.lifestyle') },
  { n: '03', label: t('shot.flatlay') },
  { n: '04', label: t('shot.detailMacro') },
];
---

<BaseLayout lang={lang} path="/" altPath="/" title={t('site.title')} ogImage={hero} transparentHeader>
  <section class="hero">
    <picture>
      <source media="(max-aspect-ratio: 3/4)" srcset={portraitSet} sizes="100vw" type="image/webp" />
      <img
        class="hero__img"
        src={heroDefault.src}
        srcset={landscapeSet}
        sizes="100vw"
        width={hero.width}
        height={hero.height}
        alt={t('home.heroAlt')}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__overlay"></div>
    <div class="wrap hero__content">
      <p class="eyebrow hero__eyebrow">{t('site.tagline')}</p>
      <h1 class="hero__title">{site.name}</h1>
      <div class="hero__scroll">
        <span class="hero__line" aria-hidden="true"></span>
        <span class="visually-hidden">{t('home.scroll')}</span>
      </div>
    </div>
  </section>

  <section class="wrap intro fade-in">
    <p class="intro__text">{t('home.intro')}</p>
  </section>

  <section class="wrap selected">
    <div class="selected__head fade-in">
      <h2>{t('home.selectedWork')}</h2>
      <a class="textlink" href={href('/work', lang)}>{t('home.allWork')} <span aria-hidden="true">→</span></a>
    </div>
    <div class="selected__grid">
      {
        projects.map((project) => (
          <div class="fade-in">
            <ProjectCard
              lang={lang}
              project={project}
              sizes="(min-width: 1100px) 23vw, (min-width: 600px) 46vw, 92vw"
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap shoot">
    <div class="selected__head fade-in">
      <h2>{t('home.shootHeading')}</h2>
      <a class="textlink" href={href('/services', lang)}>{t('home.servicesLink')} <span aria-hidden="true">→</span></a>
    </div>
    <ul class="shoot__list fade-in">
      {
        shots.map((s) => (
          <li>
            <a class="shoot__item" href={href('/services', lang)}>
              <span class="eyebrow">{s.n}</span>
              <span class="shoot__label">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #1b1c1f;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0) 0%, rgba(10, 10, 12, 0) 40%, rgba(10, 10, 12, 0.6) 100%);
  }

  .hero__content {
    position: relative;
    width: 100%;
    color: #fff;
    padding-block: 0 3rem;
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__title {
    margin-top: 0.5rem;
    color: #fff;
    font-size: clamp(3.2rem, 11vw, 8rem);
    line-height: 1;
  }

  .hero__scroll {
    margin-top: 2rem;
  }

  .hero__line {
    display: block;
    position: relative;
    width: 1px;
    height: 48px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.25);
  }

  .hero__line::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 50%;
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-100%);
    animation: scroll-pulse 2.4s var(--ease) infinite;
  }

  @keyframes scroll-pulse {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(200%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line::after {
      animation: none !important;
      transform: translateY(0);
      height: 100%;
      background: rgba(255, 255, 255, 0.6);
    }
  }

  .intro {
    padding-block: 5rem 3rem;
  }

  .intro__text {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.3;
    max-width: 28ch;
  }

  .selected {
    padding-block: 3rem 5rem;
  }

  .selected__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 2rem;
  }

  .selected__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 1.5rem;
  }

  .textlink {
    font-size: 0.9rem;
    font-weight: 500;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .shoot {
    padding-block: 1rem 6rem;
  }

  .shoot__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
  }

  .shoot__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
    transition: border-color 0.3s var(--ease);
  }

  .shoot__label {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.25;
  }

  @media (min-width: 600px) {
    .selected__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .selected__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem 1.25rem;
    }
  }

  @media (min-width: 900px) {
    .shoot__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .shoot__item:hover {
      border-color: var(--color-text);
    }
  }
</style>
