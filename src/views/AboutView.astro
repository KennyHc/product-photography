---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { href } from '../lib/paths';
import { site } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/about/portrait1.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/about"
  altPath="/about"
  title={`${t('about.heading')} | ${t('site.title')}`}
  ogImage={portrait}
>
  <section class="wrap about">
    <div class="about__head fade-in">
      <p class="eyebrow">{t('about.eyebrow')}</p>
      <h1>{t('about.heading')}</h1>
    </div>

    <div class="about__grid">
      <div class="about__media fade-in">
        <Image
          src={portrait}
          alt={t('about.portraitAlt')}
          widths={[480, 800, 1100]}
          sizes="(min-width: 900px) 40vw, 100vw"
          format="webp"
          loading="eager"
          class="about__img"
        />
      </div>
      <div class="about__text fade-in">
        <p class="about__lead">{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
        <p class="about__more">
          {t('about.closing')}
          <a class="about__link" href={href('/services', lang)}>{t('about.closingLink')}</a>
        </p>
        <p class="about__events">
          {t('about.events')}
          <a class="about__link" href={site.eventSiteUrl} target="_blank" rel="noopener noreferrer"
            >{t('about.eventsLink')}</a
          >
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: 8.5rem 6rem;
  }

  .about__head h1 {
    margin-top: 0.5rem;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .about__media {
    aspect-ratio: 4 / 5;
    background: var(--color-bg-raised);
    overflow: hidden;
    width: 100%;
  }

  .about__media :global(.about__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 56ch;
    color: var(--color-text-muted);
  }

  .about__lead {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.35;
    color: var(--color-text);
  }

  .about__more {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .about__events {
    font-size: 0.9rem;
  }

  .about__link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    margin-left: 0.25em;
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
      align-items: start;
    }

    .about__text {
      padding-top: 1rem;
    }
  }
</style>
